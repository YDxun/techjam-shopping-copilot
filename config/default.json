{
  "env_mode": "dev",
  "retrieval_backend": "bm25",
  "top_k": 10,
  "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
  "reranker_model": "BAAI/bge-reranker-v2-m3",
  "blair_offline_embedding_path": "data/offline_blair_embeds.npy",
  "blair_query_encoder_model": "hyp1231/blair-roberta-large",
  "clarify_strategy": "other",
  "override_erase": false,
  "skip_data_verify": false,
  "sample_limit": null,
  "output_path": "results.json",
  "max_constraint_asks": 3,
  "llm_intent_enabled": false,
  "llm_clarify_enabled": false,
  "llm": {
    "provider": "deepseek",
    "rerank_enabled": false,
    "rerank_candidates": 12,
    "health_check_enabled": true,
    "connect_timeout_seconds": 3.0,
    "timeout_seconds": 8.0,
    "temperature": 0.0,
    "max_tokens": 256,
    "retry": {
      "max_retries": 2,
      "base_delay_seconds": 0.5,
      "max_delay_seconds": 1.5
    },
    "circuit_breaker": {
      "failure_threshold": 2
    },
    "providers": {
      "deepseek": {
        "model": "deepseek-chat",
        "base_url": "https://api.deepseek.com",
        "token_limit_parameter": "max_tokens",
        "supports_temperature": true
      },
      "openai": {
        "model": "gpt-4o-mini",
        "base_url": "https://api.openai.com/v1",
        "token_limit_parameter": "max_completion_tokens",
        "supports_temperature": true
      }
    }
  },
  "reranker_model_enabled": false
}
