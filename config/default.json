{
  "env_mode": "dev",
  "retrieval_backend": "auto",
  "top_k": 10,
  "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
  "reranker_model": "BAAI/bge-reranker-v2-m3",
  "blair_offline_embedding_path": "data/offline_blair_embeds.npy",
  "blair_query_encoder_model": "hyp1231/blair-roberta-large",
  "clarify_strategy": "other",
  "override_erase": false,
  "skip_data_verify": false,
  "sample_limit": null,
  "output_path": "results.json",
  "max_constraint_asks": 3,
  "llm_intent_enabled": true,
  "llm_clarify_enabled": false,
  "reranker_model_enabled": false,
  "dialogue_understanding": {
    "mode": "cascaded",
    "rule_confidence_threshold": 0.75,
    "max_evidence_length": 180,
    "intent_llm": {
      "json_output": true,
      "thinking_mode": "disabled",
      "normalization_vocab_enabled": true,
      "normalization_min_product_count": 1
    },
    "transition_guard": {
      "enabled": false,
      "add_min_confidence": 0.65,
      "replace_min_confidence": 0.9,
      "remove_min_confidence": 0.9,
      "reject_products_min_confidence": 0.9,
      "no_preference_min_confidence": 0.85,
      "no_more_preferences_min_confidence": 0.95,
      "low_confidence_add_action": "soften",
      "destructive_failure_action": "clarify"
    }
  },
  "decision": {
    "max_questions": 3,
    "ask_other_first": true,
    "question_template_mode": "random",
    "ask_utility": {
      "normalization": "clamp_0_1",
      "minimum_ask_utility": 0.2,
      "weights": {
        "information_gain": 0.3,
        "constraint_gap": 0.25,
        "answer_probability": 0.15,
        "ambiguity_reduction": 0.2,
        "repeat_penalty": 0.4,
        "no_preference_penalty": 0.6,
        "turn_cost": 0.15
      }
    },
    "stop_utility": {
      "minimum_stop_utility": 0.65,
      "weights": {
        "constraint_completeness": 0.35,
        "intent_confidence": 0.25,
        "asked_count": 0.15,
        "turn_pressure": 0.25,
        "unresolved_ambiguity": 0.3
      }
    },
    "candidate_question_value": {
      "enabled": false,
      "pool_size": 300,
      "prior_alpha": 0.25,
      "prior_temperature": 1.0,
      "other_answer_probability": 0.75,
      "other_vagueness_penalty": 0.1,
      "weights": {
        "expected_shrink": 0.3,
        "coverage": 0.15,
        "complementarity": 0.15,
        "answer_probability": 0.15,
        "missing_penalty": 0.2,
        "redundancy_penalty": 0.2,
        "repeat_penalty": 0.4,
        "no_preference_penalty": 0.6,
        "turn_cost": 0.15
      }
    },
    "hybrid_question_policy": {
      "enabled": false,
      "max_replacements_per_session": 1,
      "only_after_other_asked": true,
      "pool_size": 300,
      "prior_alpha": 0.25,
      "prior_temperature": 1.0,
      "minimum_coverage": 0.6,
      "maximum_missing_rate": 0.4,
      "minimum_expected_shrink": 0.25,
      "minimum_resolve_at_10": 0.05,
      "minimum_gain": 0.25,
      "weights": {
        "expected_shrink": 0.4,
        "resolve_at_10": 0.25,
        "coverage": 0.15,
        "answer_probability": 0.1,
        "extraction_confidence": 0.1,
        "missing_penalty": 0.25,
        "turn_cost": 0.1
      }
    },
    "finish_strategy": {
      "enabled": false,
      "candidate_threshold": 100,
      "remaining_question_threshold": 2,
      "lookahead_depth": 1,
      "minimum_finish_gain": 0.0,
      "weights": {
        "resolve_at_10": 0.5,
        "resolve_at_3": 0.2,
        "resolve_at_1": 0.1,
        "terminal_progress": 0.3,
        "p90_remaining_penalty": 0.2
      }
    },
    "question_termination_mode": "legacy"
  },
  "diagnostics": {
    "decision_trace": {
      "enabled": false,
      "include_attribute_scores": true,
      "include_state_diff": true,
      "max_traces": 5000,
      "output_path": "decision_traces.jsonl"
    }
  },
  "llm": {
    "provider": "deepseek",
    "rerank_enabled": false,
    "rerank_candidates": 12,
    "health_check_enabled": true,
    "connect_timeout_seconds": 3.0,
    "timeout_seconds": 8.0,
    "temperature": 0.0,
    "max_tokens": 256,
    "retry": {
      "max_retries": 2,
      "base_delay_seconds": 0.5,
      "max_delay_seconds": 1.5
    },
    "circuit_breaker": {
      "failure_threshold": 2
    },
    "providers": {
      "deepseek": {
        "model": "deepseek-v4-flash",
        "base_url": "https://api.deepseek.com",
        "token_limit_parameter": "max_tokens",
        "supports_temperature": true
      },
      "openai": {
        "model": "gpt-4o-mini",
        "base_url": "https://api.openai.com/v1",
        "token_limit_parameter": "max_completion_tokens",
        "supports_temperature": true
      }
    },
    "rerank_backend": "text",
    "qwen_rerank_model": "qwen3-rerank",
    "dashscope_workspace_id": "",
    "qwen_rerank_base_url": ""
  },
  "asset_vocab_expand": false,
  "asset_category_expand": true,
  "asset_paraphrase": true,
  "asset_field_map": false,
  "hard_cue_enabled": true,
  "retrieval_mode": {
    "exploit_min_hard": 2,
    "exploit_min_constraints": 4
  },
  "retrieval_pool_size": 300,
  "retrieval": {
    "bm25_field_weights": [
      0.0,
      6.0,
      4.0,
      2.5,
      2.5,
      1.5,
      1.0
    ],
    "rrf_k": 100.0,
    "rrf_constraint_k": 10.0,
    "dense_weight": 0.5,
    "bm25_limit_mult": 2,
    "recall_limit_mult": 3
  },
  "rerank_weights": {
    "coverage": 0.5,
    "combo": 0.1,
    "category": 0.25,
    "rrf": 0.15,
    "popularity": 0.05,
    "profile": 0.05
  },
  "fingerprint": {
    "enable": true,
    "bonus_unique": 1.0,
    "bonus_ten": 0.5,
    "bonus_fifty": 0.2,
    "max_count": 50
  },
  "emit_gate": true,
  "emit_late_turn": 5,
  "emit_k0": 1,
  "emit_k1": 1,
  "emit_k2": 1,
  "emit_fp_confident": 3,
  "emit_margin_confident": 0.1,
  "emit_commit_constraints": 4
}
